generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CANDIDATE
}

enum SectionType {
  LISTENING
  STRUCTURE
  READING
}

enum CorrectOption {
  A
  B
  C
  D
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum CefrBand {
  A2
  B1
  B2
  C1
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  role      Role     @default(CANDIDATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts ExamAttempt[]

  @@map("users")
}

model TestPackage {
  id             String   @id @default(uuid())
  title          String
  description    String?
  totalQuestions Int      @default(140)
  totalDuration  Int      @default(115)
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sections Section[]
  attempts ExamAttempt[]

  @@map("test_packages")
}

model Section {
  id              String      @id @default(uuid())
  packageId       String
  type            SectionType
  orderIndex      Int
  title           String
  durationMinutes Int
  totalItems      Int

  package   TestPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  stimuli   Stimulus[]
  questions Question[]

  @@map("sections")
}

model Stimulus {
  id         String  @id @default(uuid())
  sectionId  String
  title      String?
  content    String?
  audioUrl   String?
  orderIndex Int

  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions Question[]

  @@map("stimuli")
}

model Question {
  id             String        @id @default(uuid())
  sectionId      String
  stimulusId     String?
  questionNumber Int
  prompt         String?
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correctAnswer  CorrectOption
  explanation    String?
  skillCategory  String?

  section  Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  stimulus Stimulus?         @relation(fields: [stimulusId], references: [id], onDelete: SetNull)
  answers  CandidateAnswer[]

  @@map("questions")
}

model ExamAttempt {
  id             String        @id @default(uuid())
  candidateId    String?
  candidateName  String
  candidateEmail String?
  packageId      String
  status         AttemptStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  expiresAt   DateTime

  tabSwitchCount Int     @default(0)
  browserDetails String?

  rawListening    Int?
  scaledListening Int?

  rawStructure    Int?
  scaledStructure Int?

  rawReading    Int?
  scaledReading Int?

  totalScaledScore Int?
  cefrLevel        CefrBand?

  verificationToken String @unique @default(cuid())

  candidate   User?             @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  package     TestPackage       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  answers     CandidateAnswer[]
  certificate Certificate?

  @@map("exam_attempts")
}

model CandidateAnswer {
  id             String         @id @default(uuid())
  attemptId      String
  questionId     String
  selectedOption CorrectOption?
  isFlagged      Boolean        @default(false)
  isCorrect      Boolean?
  answeredAt     DateTime?      @updatedAt

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("candidate_answers")
}

model Certificate {
  id                String   @id @default(uuid())
  attemptId         String   @unique
  certificateNumber String   @unique
  candidateName     String
  totalScore        Int
  cefrLevel         CefrBand
  issuedAt          DateTime @default(now())
  securityHash      String

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("certificates")
}
